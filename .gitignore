# Only source, tests, and documentation belong in this repository.
# Ignore rules are a guardrail, not a substitute for reviewing staged content.

# Deny new file types by default. Extend this allowlist deliberately when needed.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/USER_GUIDE.md
!/docs/PYTHON_FILE_MAP.md
!/docs/LLM_HANDOVER.md
!/docs/LOCARD_6_138_RECORDED_HISTORY_REFACTOR.md
!/VALIDATION.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/V3.md
!/V4.md
!/V5.md
!/pyproject.toml
!/requirements.txt
!/forensic_assistant/
!/tests/
/forensic_assistant/**
!/forensic_assistant/**/
!/forensic_assistant/**/*.py
!/forensic_assistant/database/schema.sql
/tests/**
!/tests/**/
!/tests/**/*.py
!/forensic_assistant/resources/
!/forensic_assistant/resources/*.txt

# Investigation data and generated output, at any directory depth.
data/
evidence/
cases/
artifacts/
acquisitions/
exports/
reports/
outputs/
work/
scratch/
tmp/
temp/
logs/

# Windows logs, forensic captures, images, and memory dumps (case-insensitive).
*.[eE][vV][tT][xX]
*.[eE][vV][tT]
*.[eE][tT][lL]
*.[eE][0-9][0-9]
*.[eE][xX][0-9][0-9]
*.[sS][0-9][0-9]
*.[aA][fF][fF]*
*.[rR][aA][wW]
*.[iI][mM][gG]
*.[iI][sS][oO]
*.[vV][hH][dD]*
*.[vV][mM][dD][kK]
*.[dD][dD]
*.[dD][mM][pP]
*.[mM][eE][mM]
*.[pP][cC][aA][pP]*
*.[hH][iI][vV][eE]
*.[rR][eE][gG]
*.[pP][fF]
*.[dD][aA][tT]
$MFT
$LogFile
$UsnJrnl
NTUSER.*
ntuser.*
UsrClass.*
usrclass.*

# Databases and their journals/sidecars, anywhere in the tree.
*.[dD][bB]*
*.[sS][qQ][lL][iI][tT][eE]*
*.[mM][dD][bB]
*.[aA][cC][cC][dD][bB]

# Model weights and local model caches.
models/
checkpoints/
.cache/
*.[gG][gG][uU][fF]
*.[gG][gG][mM][lL]
*.[sS][aA][fF][eE][tT][eE][nN][sS][oO][rR][sS]
*.[bB][iI][nN]
*.[pP][tT]
*.[pP][tT][hH]
*.[cC][kK][pP][tT]
*.[oO][nN][nN][xX]

# Credentials and machine-local configuration.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.kdbx
credentials*
secrets*
.aws/
.azure/
.ssh/
.codex/
.agents/
*.local
*.local.*

# Python environments, caches, build and test output.
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
build/
dist/
wheelhouse/
.coverage*
htmlcov/
coverage.xml

# Temporary files, archives, editor state, and system metadata.
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Application adapters are allowed above; reopen their directory only.
!/forensic_assistant/artifacts/

# Sensitive semantic derived data, regardless of location.
semantic-index/
*.semantic-index/
semantic-models/
embedding-cache/
*.safetensors
*.npy
*.npz
*.faiss
*.index
*.semantic-stage

# Derived investigation transcripts and state are sensitive case data.
investigations/
*.investigations/
transcripts/
*.jsonl

# Derived V5 report bundles and interrupted publication staging.
report-bundles/
*.locard-report/
.locard-report-*/

